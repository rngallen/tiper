# Same-origin API base (required for HttpOnly cookies).
NEXT_PUBLIC_API_BASE=/api/v1
# Fiber upstream for the Next.js /api/[...path] proxy.
API_PROXY_TARGET=http://127.0.0.1:8080

# Idle logout is not configured here. Operators set it under
# Settings → Operations → Session. The UI reads the live values from
# login and GET /auth/profile.
